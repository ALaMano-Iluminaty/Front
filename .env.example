# URL base del API Gateway (REST)
VITE_API_GATEWAY_URL=http://localhost:8080/api

# URL del gateway de WebSocket (eventos del broker)
VITE_WS_GATEWAY_URL=ws://localhost:8080/ws

# true = datos y eventos simulados en el navegador, sin gateway.
# Sirve para ver las pantallas mientras el backend no existe.
VITE_USE_MOCKS=true
